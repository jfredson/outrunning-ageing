---
// Site navigation, from the Sentient Horizons design standard (design/shell.html): the spine of
// the site in heavier ink, the reference pages lighter after a rule, the theme toggle last;
// collapses to a menu on small screens. Which page goes in which tier follows the tracker pattern
// (design/tracker-pattern.md, rule 4.6, ruled by John 2026-10-16): the spine is the tree, the two
// pages this site is built around (the claims log and the self-experiments), this week's reading
// and the story so far; the method and the disagree page sit behind the rule in the lighter tier,
// with the source link last as the siblings have it. There is no Home link: the site's name links
// home, as the standard's section 6 says.
// Rule 4.7 (ruled by John 2026-10-16): the bar carries short handles, one or two words per page,
// and the full plain names stay as the page titles and in the footer. The handles are the ones the
// Ledger skin's mock-up shows and John pre-approved on 2026-10-17 through the master session
// ("go ahead and run with it and we can revise it as necessary later today"): Branches · Claims ·
// Reading · Story | Method · Disagree · Source, The Upgrade Tree's scheme exactly. John ruled on
// 2026-10-17 that "Self-experiments" joins the spine after "Claims", as rule 4.6 has it (the first
// build had left it to the footer, the home page and the claims log). The extra name needs about
// 1000px on one row, so the bar collapsed to the menu at 1020px until 2026-10-21, when the five-page bar
// brought it back to the skeleton's 820px.
import { REPO } from '../lib/records';
const path = Astro.url.pathname;
// Simplified on 2026-10-21 (tracker pattern rule 4.21, ruled by John that day), which replaces the
// tiers described above: the pages a reader would come for, then Family beside the theme switch (rule
// 4.9). Method and Story became the two parts of About; this week's reading keeps its page and is
// linked from the home page, About, News and the footer; Feedback and Source moved to the footer.
const primary = [
  { href: '/branches/', label: 'Branches', also: ['/leaves/'] },
  { href: '/claims/', label: 'Claims', also: [] },
  { href: '/self-experiments/', label: 'Self-experiments', also: [] },
  { href: '/news/', label: 'News', also: [] }, // tracker pattern rule 4.10
  { href: '/about/', label: 'About', also: [] },
];
const secondary = [
  { href: 'https://sentient-horizons.com/projects/', label: 'Family', also: [] }, // the family's Projects page; tracker pattern rule 4.9
];
const isActive = (l: { href: string; also: string[] }) =>
  !l.href.startsWith('http') && (path.startsWith(l.href) || l.also.some((a) => path.startsWith(a)));
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">Outrunning Ageing</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="ico-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      <svg class="ico-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav class="navlinks" id="site-nav">
      {primary.map((l) => (
        <a href={l.href} class={`nav-primary ${isActive(l) ? 'active' : ''}`}>{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {secondary.map((l) => (
        <a href={l.href} class={`nav-secondary ${isActive(l) ? 'active' : ''}`} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = header && header.querySelector('.nav-toggle');
    var menu = document.getElementById('site-nav');
    if (!btn || !menu) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () { setOpen(!header.classList.contains('nav-open')); });
    menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    window.addEventListener('resize', function () { if (window.innerWidth > 820) setOpen(false); });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var meta = document.getElementById('theme-color-meta');
    var COLORS = { dark: '#10161c', light: '#f3eee3' };
    function sync(theme) {
      document.documentElement.dataset.theme = theme;
      if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.dark);
    }
    sync(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync(next);
    });
  })();
</script>
