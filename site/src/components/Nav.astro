---
// Site navigation, from the Sentient Horizons design standard (design/shell.html): the spine of
// the site in heavier ink, the reference pages lighter, the theme toggle last; collapses to a menu
// on small screens. Holding version, 2026-10-16: the site has one page, so the links point at its
// sections, and the disagree link opens a new issue in the repository until the disagree page and
// its three templates exist. The site session replaces these with the tracker pattern's seven
// pages (design/tracker-pattern.md, section 4; rule 4.6 says which tier each goes in) plus the
// claims and self-experiments pages in the spine. There is no Home link: the site's name links
// home, as the standard's section 6 says. The source link lives in the footer (section 7).
import { REPO } from '../lib/records';
const primary = [
  { href: '/#branches', label: 'The eight branches' },
  { href: '/#records', label: 'What is recorded' },
];
const secondary = [
  { href: '/#method', label: 'How the numbers are worked out' },
  { href: `${REPO}/issues/new`, label: 'Disagree' },
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">Outrunning Ageing</a>
    <button type="button" class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
      <svg class="ico-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
      <svg class="ico-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <nav class="navlinks" id="site-nav">
      {primary.map((l) => (
        <a href={l.href} class="nav-primary">{l.label}</a>
      ))}
      <span class="nav-divider" aria-hidden="true"></span>
      {secondary.map((l) => (
        <a href={l.href} class="nav-secondary" rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    var btn = header && header.querySelector('.nav-toggle');
    var menu = document.getElementById('site-nav');
    if (!btn || !menu) return;
    function setOpen(open) {
      header.classList.toggle('nav-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    btn.addEventListener('click', function () { setOpen(!header.classList.contains('nav-open')); });
    menu.addEventListener('click', function (e) { if (e.target.closest('a')) setOpen(false); });
    window.addEventListener('resize', function () { if (window.innerWidth > 820) setOpen(false); });
  })();
</script>

<script is:inline>
  (function () {
    var btn = document.querySelector('.theme-toggle');
    if (!btn) return;
    var meta = document.getElementById('theme-color-meta');
    var COLORS = { dark: '#08070f', light: '#faf9f7' };
    function sync(theme) {
      document.documentElement.dataset.theme = theme;
      if (meta) meta.setAttribute('content', COLORS[theme] || COLORS.dark);
    }
    sync(document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
    btn.addEventListener('click', function () {
      var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync(next);
    });
  })();
</script>
