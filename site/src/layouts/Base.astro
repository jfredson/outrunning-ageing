---
// The page shell, from the Sentient Horizons design standard (design/shell.html): the theme script,
// the top bar (Nav.astro), the page, and the footer with the family line last. The medical notice
// of kickoff decision 9 was removed on John's ruling of 2026-10-18. No backdrop: the site wears the
// Ledger skin (styles/skin.css, ruled 2026-10-17), paper and ink, and the chart is the picture.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { records, longDate, builtFrom, REPO, SITE_NAME } from '../lib/records';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = SITE_NAME,
  description = 'When, if ever, does the rate of repairing the human body overtake the rate at which it ages? A public tracker: a year computed from the record of treatments and measuring tools, and a dated log of who promised what and when.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The preview picture link cards show (site/public/social-preview.png, made by scripts/social-image.mjs); an absolute address, as the tags require.
const socialImage = new URL('/social-preview.png', Astro.site).href;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. Light is the default on this site (the Ledger skin, ruled 2026-10-17); dark only when the visitor asks for it. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#f3eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Outrunning Ageing: When do we start outrunning ageing?" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">{SITE_NAME}</span>
          <p class="footer-tag">A public tracker of when the rate of repairing the human body overtakes the rate at which it ages. Every number on this site is computed from the records in the public repository.</p>
          <p class="footer-links">
            <a href="/branches/">The tree</a>
            <a href="/claims/">The claims log</a>
            <a href="/self-experiments/">Other people's self-experiments</a>
            <a href="/reading/">This week's reading</a>
            <a href="/story/">The story so far</a>
            <a href="/method/">How the numbers are worked out</a>
            <a href="/disagree/">Disagree with something</a>
            <a href={REPO} rel="noopener">Source on GitHub</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson. Last built {longDate(records.exported_on)} from {builtFrom()}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
