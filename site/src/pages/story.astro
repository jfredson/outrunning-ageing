---
// The story so far: the publications log read as a dated, append-only record (tracker pattern,
// rules 4.2 and 4.3). Each entry is a paper, trial report or regulator's record, says which
// treatments and branches it bears on, and says what it did to the tree: settled a stage, moved
// an estimate, or was read and moved nothing. The entries that moved nothing get the same card as
// the ones that did, with equal billing: a reader who sees the year move should be able to tell
// whether the world got closer or the author changed his mind. Revisions to a treatment's estimate
// and the weekly reading's moves join the same list as they happen. The repository's changelog is
// not shown: John ruled on 2026-10-18 that the public site shows no raw record text. In its place,
// "What changed, day by day" (ruled by John the same day) gives one plain line per day built only
// from the records' own flags: a treatment moved up a rung, a range revised or set, papers logged, a
// weekly reading run, or, on a day with only wording changes, "the site's wording changed"
// (scripts/export.py, what_changed). The entry card is copied from The Quiet Galaxy's story page
// (which copied The Belt Equation's), on 2026-10-17.
import Base from '../layouts/Base.astro';
import { records, longDate, worldDate, plural, lowerFirst, publicationById, type StoryEntry } from '../lib/records';

const story = records.story;
const totals = story.totals;
const days = story.days.map((date) => ({ date, entries: story.entries.filter((e) => e.date === date) }));
const kindLabel = (e: StoryEntry) => e.kind_label;
const h = records.headline;
const changed = story.what_changed;
const capital = (t: string, first: boolean) => (first ? t.charAt(0).toUpperCase() + t.slice(1) : t);
// A treatment's name opens with a capital; inside a line it is written from a small letter.
const name = (t: string, first: boolean) => (first ? t : lowerFirst(t));
---

<Base title="The story so far · Outrunning Ageing" description="Every paper, trial report and regulator's record that bears on the tree, dated, newest first, each saying what it settled or moved, and the ones that moved nothing beside them.">
  <section class="hero">
    <p class="eyebrow">The story so far</p>
    <h1>What has been read, and what it moved</h1>
    <p class="lede">
      Everything that bears on the year at the top of the site is logged here with the date it was read, which treatments and branches it touches, and one plain question answered: did it settle a stage or move an estimate? Most do neither, and saying so is the point.
    </p>
    <p class="dim" style="font-size: 14px;">
      The log is only ever added to. An entry is never edited except to fix an error, with a line in the changelog saying so. The founding papers were logged on 16 October 2026; from the site's launch, each new paper is logged as it is read, and the weekly reading of the treatments against the news adds its moves here. {h.available ? `The year was last computed on ${longDate(h.computed_on)}.` : ''}
    </p>
  </section>

  {changed.length > 0 && (
    <section class="section narrow" id="what-changed" style="padding-top: 0;">
      <h2>What changed, day by day</h2>
      <p class="dim" style="font-size: 14px;">
        One line for each day the records changed, newest first, made from the records themselves: the year at the top moving, a treatment moving up a rung, a range of years revised, a treatment, claim or self-experiment added, papers logged, a weekly reading run. A day whose only changes were to the wording says so. Each line links to the change it names.
      </p>
      <ul class="checks changed">
        {changed.map((d) => {
          const parts: any[] = [];
          if (d.year) {
            const y = d.year;
            parts.push((first: boolean) => <><a href="/method/">{capital(`the year at the top moved from ${y.old} to ${y.new}`, first)}</a>{y.branch && <>, with <a href={y.branch.path}>{lowerFirst(y.branch.name)}</a> the branch that moved it</>}</>);
          }
          d.readings.forEach((r) => parts.push((first: boolean) => <a href={r.path}>{capital('the weekly reading ran', first)}</a>));
          d.moves.forEach((m) => parts.push((first: boolean) => <><a href={m.leaf.path}>{name(m.leaf.name, first)}</a>{' '}<a href={m.path}>moved up a rung</a>, from {m.from} to {m.to}</>));
          d.ranges.forEach((r) => parts.push((first: boolean) => r.kind === 'revised'
            ? <><a href={r.leaf.path}>{name(r.leaf.name, first)}</a>: its {r.changes.length === 1 ? `${r.changes[0].which} year` : 'range'} to {r.goal}{' '}<a href={r.path}>was revised</a>, {r.changes.map((c, i) => <>{i > 0 ? ', ' : ''}{r.changes.length === 1 ? '' : `${c.which} `}from {c.old} to {c.new}</>)}</>
            : <><a href={r.leaf.path}>{name(r.leaf.name, first)}</a>: a range to {r.goal}{' '}<a href={r.path}>was set</a>, {r.years}</>));
          // Three or fewer additions are named; more are counted, linked to the page that lists them.
          const addedPart = (items: { name: string; path: string }[], one: string, several: string, many: string, all: string, quoted: boolean) => (first: boolean) =>
            items.length > 3
              ? <a href={all}>{capital(`${items.length} ${many} were added`, first)}</a>
              : <>{capital(items.length === 1 ? one : several, first)}{items.map((it, i) => <>{i === 0 ? '' : i === items.length - 1 ? ' and ' : ', '}<a href={it.path}>{quoted ? `“${it.name}”` : it.name}</a></>)}{' '}{items.length === 1 ? 'was' : 'were'} added</>;
          if (d.added.leaf.length > 0) parts.push(addedPart(d.added.leaf, 'the treatment ', 'the treatments ', 'treatments and tools', '/branches/', true));
          if (d.added.claim.length > 0) parts.push(addedPart(d.added.claim, 'a claim by ', 'claims by ', 'claims', '/claims/', false));
          if (d.added.experiment.length > 0) parts.push(addedPart(d.added.experiment, 'the self-experiment of ', 'the self-experiments of ', 'self-experiments', '/self-experiments/', false));
          if (d.papers > 0) parts.push((first: boolean) => <a href={`#logged-${d.date}`}>{capital(d.papers === 1 ? 'one paper was logged' : `${d.papers} papers were logged`, first)}</a>);
          if (d.wording) parts.push((first: boolean) => <>{capital("the site's wording changed", first)}</>);
          return (
            <li>
              <span class="check-date">{longDate(d.date)}</span>
              <p>{parts.map((part, i) => <>{i > 0 ? '; ' : ''}{part(i === 0)}</>)}.</p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="section narrow" style="padding-top: 0;">
    <ul class="tally">
      <li><span class="stat">{story.entries.length}</span><span class="stat-label">{story.entries.length === 1 ? 'entry' : 'entries'} in the log</span></li>
      <li><span class="stat">{totals['stage-settled']}</span><span class="stat-label">settled a stage</span></li>
      <li><span class="stat">{story.moved_estimate}</span><span class="stat-label">moved an estimate</span></li>
      <li><span class="stat">{totals.held}</span><span class="stat-label">read and logged; moved nothing</span></li>
      <li><span class="stat">{days.length}</span><span class="stat-label">{days.length === 1 ? 'day' : 'days'} on which something was logged</span></li>
    </ul>

    {story.entries.length === 0 ? (
      <p class="empty">Nothing has been logged yet.</p>
    ) : days.map((day) => (
      <div class="day">
        <h2 id={`logged-${day.date}`}>Logged {longDate(day.date)}</h2>
        <div class="entries">
          {day.entries.map((e) => {
            const p = e.publication ? publicationById(e.publication) : null;
            if (p) {
              return (
                <details class="entry" id={p.id}>
                  <summary>
                    <span class="entry-meta">
                      <span class="entry-date">appeared {worldDate(p.date)}</span>
                      <span class={`kind kind-${p.kind}`}>{p.kind_label}</span>
                      {p.branches.map((b) => <a class="chip" href={b.path}>{b.name}</a>)}
                      {p.leaves.filter((lf) => !p.branches.some((b) => b.key === lf.branch)).map((lf) => <a class="chip" href={`/branches/${lf.branch}/`}>{lf.branch_name}</a>)}
                    </span>
                    <span class="entry-title">{p.title}</span>
                    <span class="entry-authors">{p.authors_short}</span>
                  </summary>
                  <div class="entry-body">
                    <p>{p.finding}</p>
                    <p class="dim" style="font-size: 14px;">{p.authors.join(', ')}. <em>{p.venue}</em>. <a href={p.link} rel="noopener">Read it</a>.</p>
                    {(p.leaves.length > 0 || p.settles.length > 0) && (
                      <p style="font-size: 15px;">
                        <strong>Bears on:</strong>{' '}
                        {[...new Map([...p.settles, ...p.leaves].map((x) => [x.id, x])).values()].map((lf, i, arr) => <><a href={lf.path}>{lf.name}</a>{i < arr.length - 1 ? '; ' : '.'}</>)}
                      </p>
                    )}
                    {p.settled_stage && p.settles.length > 0 && (
                      <p style="font-size: 15px;"><strong>What it settled:</strong> {p.settles.map((s, i) => <>the rung "{s.rung_label.toLowerCase()}" of <a href={s.path}>{s.name}</a>{i < p.settles.length - 1 ? '; ' : '.'}</>)}</p>
                    )}
                    {p.moved_range && p.moved.length > 0 && (
                      <p style="font-size: 15px;"><strong>What it moved:</strong> {p.moved.map((m, i) => <>{m.field_words} for <a href={m.path}>{m.name}</a>{m.paragraph ? ' changed' : `, ${m.old_words} to ${m.new_words}`}, on {longDate(m.date)}: {m.why}{i < p.moved.length - 1 ? '; ' : ''}</>)}</p>
                    )}
                    {p.kind === 'held' && (
                      <p style="font-size: 15px;"><strong>What it moved:</strong> nothing. It was read against the treatments it bears on and no stage or estimate changed. Logging it anyway is how the record shows what has been considered.</p>
                    )}
                    {p.notes && <p class="dim" style="font-size: 14px;">{p.notes}</p>}
                    {p.verify.length > 0 && <p class="dim" style="font-size: 14px;">Not yet verified against a source: {p.verify.join(' ')}</p>}
                  </div>
                </details>
              );
            }
            if (e.kind === 'revision' && e.leaf && e.revision) {
              return (
                <div class="entry">
                  <span class="entry-meta"><span class={`kind kind-${e.kind}`}>{kindLabel(e)}</span><a class="chip" href={`/branches/${e.leaf.branch}/`}>{e.leaf.branch_name}</a></span>
                  <span class="entry-title"><a href={e.leaf.path}>{e.leaf.name}</a>: {e.revision.paragraph ? `${e.revision.field_words} changed` : `${e.revision.field_words}, ${e.revision.old_words} to ${e.revision.new_words}`}</span>
                  <div class="entry-body"><p>{e.revision.why}{e.revision.publication && <> Source: <a href={e.revision.publication.path}>{e.revision.publication.authors_short}, {worldDate(e.revision.publication.date)}</a>.</>}</p></div>
                </div>
              );
            }
            if (e.kind === 'reading' && e.leaf) {
              return (
                <div class="entry">
                  <span class="entry-meta"><span class={`kind kind-${e.kind}`}>{kindLabel(e)}</span><a class="chip" href={`/branches/${e.leaf.branch}/`}>{e.leaf.branch_name}</a></span>
                  <span class="entry-title"><a href={e.leaf.path}>{e.leaf.name}</a> moved in <a href={`/reading/#${e.reading}`}>the reading of {longDate(e.date)}</a></span>
                </div>
              );
            }
            return null;
          })}
        </div>
      </div>
    ))}
  </section>

  <section class="section narrow" style="padding-top: 0;">
    <p class="dim" style="font-size: 14px;">
      {plural(records.counts.publications, 'publication', 'publications')} in the log so far. Know a paper that should be here? <a href="/disagree/">Say so</a>, with the treatment it bears on.
    </p>
  </section>
</Base>
